class DuplicateKey(ValueError):
    pass


def reject_duplicate_keys(pairs: list[tuple[str, object]]) -> dict[str, object]:
    value: dict[str, object] = {}
    for key, item in pairs:
        if key in value:
            raise DuplicateKey(f"duplicate object key: {key}")
        value[key] = item
    return value


def reject_nonstandard_constant(value: str) -> None:
    raise ValueError(f"non-standard JSON constant: {value}")


def markdown_paths(root: Path) -> list[Path]:
    paths = []
    for path in root.rglob("*.md"):
        relative = path.relative_to(root)
        if path.is_file() and not any(part in IGNORED_DIRECTORIES for part in relative.parts):
            paths.append(path)
    return sorted(paths, key=lambda path: path.relative_to(root).as_posix())


def json_fences(path: Path, text: str) -> tuple[list[tuple[int, str]], list[str]]:
    fences: list[tuple[int, str]] = []
    errors: list[str] = []
    lines = text.splitlines(keepends=True)
    index = 0
    while index < len(lines):
        opening = JSON_FENCE.match(lines[index].rstrip("\r\n"))
        if opening is None:
            index += 1
            continue

        fence = opening.group(1)
        start_line = index + 1
        body: list[str] = []
        index += 1
        while index < len(lines):
            closing = FENCE_CLOSE.match(lines[index].rstrip("\r\n"))
            if (
                closing is not None
                and closing.group(1)[0] == fence[0]
                and len(closing.group(1)) >= len(fence)
            ):
                fences.append((start_line, "".join(body)))
                break
            body.append(lines[index])
            index += 1
        else:
            errors.append(f"line {start_line}: unclosed fenced JSON block")
            break
        index += 1
    return fences, errors


def severity_errors(value: object, location: str = "$") -> list[str]:
    errors: list[str] = []
    if isinstance(value, dict):
        for key, item in value.items():
            item_location = f"{location}.{key}"
            if (key == "severity" or key.endswith("_severity")) and (
                not isinstance(item, str) or item not in ALLOWED_SEVERITIES
            ):
                errors.append(f"{item_location}: invalid severity enum: {item}")
            errors.extend(severity_errors(item, item_location))
    elif isinstance(value, list):
        for index, item in enumerate(value):
            errors.extend(severity_errors(item, f"{location}[{index}]"))
    return errors


def validate_fenced_json(root: Path, paths: list[Path]) -> tuple[list[str], int]:
    errors: list[str] = []
    count = 0
    for path in paths:
        relative = path.relative_to(root).as_posix()
        try:
            text = path.read_text(encoding="utf-8")
        except UnicodeError as error:
            errors.append(f"{relative}: Markdown is not valid UTF-8: {error}")
            continue
        fences, fence_errors = json_fences(path, text)
        errors.extend(f"{relative}:{error}" for error in fence_errors)
        for line, payload in fences:
            count += 1
            try:
                value = json.loads(
                    payload,
                    object_pairs_hook=reject_duplicate_keys,
                    parse_constant=reject_nonstandard_constant,
                )
            except (json.JSONDecodeError, ValueError) as error:
                errors.append(f"{relative}:{line}: invalid fenced JSON: {error}")
                continue
            if relative in ACTIVE_MARKDOWN:
                errors.extend(
                    f"{relative}:{line}: {error}" for error in severity_errors(value)
                )
    return errors, count


def prose_lines(text: str) -> list[tuple[int, str]]:
    lines: list[tuple[int, str]] = []
    open_fence: str | None = None
    for number, line in enumerate(text.splitlines(), start=1):
        fence = ANY_FENCE.match(line)
        if open_fence is not None:
            if (
                fence is not None
                and fence.group(1)[0] == open_fence[0]
                and len(fence.group(1)) >= len(open_fence)
            ):
                open_fence = None
            continue
        if fence is not None:
            open_fence = fence.group(1)
            continue
        lines.append((number, line))
    return lines


def link_destination(raw: str) -> str:
    raw = raw.strip()
    if raw.startswith("<"):
        end = raw.find(">")
        return raw[1:end] if end >= 0 else raw
    return raw.split(maxsplit=1)[0]


def reference_label(raw: str) -> str:
    return " ".join(raw.split()).casefold()


def mask_inline_code(line: str) -> str:
    return INLINE_CODE.sub(lambda match: " " * len(match.group(0)), line)


def resolve_local_link(root: Path, source: Path, destination: str) -> tuple[Path | None, str]:
    parsed = urlsplit(destination)
    if parsed.scheme or destination.startswith("//"):
        return None, ""
    decoded = unquote(parsed.path)
    if not decoded:
        return source, unquote(parsed.fragment)
    if decoded.startswith("/"):
        return root / decoded.removeprefix("/"), unquote(parsed.fragment)
    return source.parent / decoded, unquote(parsed.fragment)


def github_slug(heading: str) -> str:
    heading = html.unescape(heading)
    heading = MARKDOWN_LINK_LABEL.sub(r"\1", heading)
    heading = HTML_TAG.sub("", heading)
    heading = heading.replace("`", "").replace("*", "").replace("~", "")
    slug = []
    for character in heading.strip().lower():
        category = unicodedata.category(character)
        if character.isspace():
            slug.append("-")
        elif character in "-_" or category[0] in {"L", "M", "N"}:
            slug.append(character)
    return "".join(slug)


def markdown_anchors(text: str) -> set[str]:
    anchors: set[str] = set()
    slug_counts: dict[str, int] = {}
    for _, line in prose_lines(text):
        for explicit in EXPLICIT_ANCHOR.findall(line):
            anchors.add(explicit)
        heading = ATX_HEADING.match(line)
        if heading is None:
            continue
        base = github_slug(heading.group(1))
        suffix = slug_counts.get(base, 0)
        slug_counts[base] = suffix + 1
        anchors.add(base if suffix == 0 else f"{base}-{suffix}")
    return anchors


def path_case_matches(root: Path, target: Path) -> bool | None:
    lexical = Path(os.path.normpath(str(target.absolute())))
    if not lexical.is_relative_to(root):
        return None
    current = root
    for part in lexical.relative_to(root).parts:
        try:
            names = [entry.name for entry in current.iterdir()]
        except OSError:
            return None
        if part in names:
            current /= part
            continue
        if any(name.casefold() == part.casefold() for name in names):
            return False
        return None
    return True


def validate_local_links(root: Path, paths: list[Path]) -> tuple[list[str], int]:
    errors: list[str] = []
    count = 0
    anchor_cache: dict[Path, set[str]] = {}
    for source in paths:
        if not source.is_file():
            continue
        relative = source.relative_to(root).as_posix()
        text = source.read_text(encoding="utf-8")
        lines = prose_lines(text)
        definitions = {}
        for _, line in lines:
            definition = REFERENCE_DEFINITION.match(line)
            if definition is not None:
                definitions[reference_label(definition.group(1))] = link_destination(
                    definition.group(2)
                )
        for line_number, line in lines:
            masked_line = mask_inline_code(line)
            destinations = [
                link_destination(match.group(1))
                for match in INLINE_LINK.finditer(masked_line)
            ]
            for match in REFERENCE_LINK.finditer(masked_line):
                label = match.group(2) or match.group(1)
                normalized_label = reference_label(label)
                destination = definitions.get(normalized_label)
                if destination is None:
                    errors.append(
                        f"{relative}:{line_number}: reference link definition "
                        f"does not exist: {label}"
                    )
                    continue
                destinations.append(destination)
            for destination in destinations:
                target, fragment = resolve_local_link(root, source, destination)
                if target is None:
                    continue
                count += 1
                normalized = target.resolve(strict=False)
                if not normalized.is_relative_to(root):
                    errors.append(
                        f"{relative}:{line_number}: local link escapes repository: {destination}"
                    )
                elif path_case_matches(root, target) is False:
                    errors.append(
                        f"{relative}:{line_number}: link path casing does not match: "
                        f"{destination}"
                    )
                elif not normalized.exists():
                    errors.append(
                        f"{relative}:{line_number}: link target does not exist: {destination}"
                    )
                elif fragment and normalized.suffix.lower() in {"", ".md", ".markdown"}:
                    if normalized not in anchor_cache:
                        try:
                            target_text = normalized.read_text(encoding="utf-8")
                        except (OSError, UnicodeError) as error:
                            errors.append(
                                f"{relative}:{line_number}: cannot read anchor target "
                                f"{destination}: {error}"
                            )
                            continue
                        anchor_cache[normalized] = markdown_anchors(target_text)
                    if fragment not in anchor_cache[normalized]:
                        errors.append(
                            f"{relative}:{line_number}: link anchor does not exist: "
                            f"{destination}"
                        )
    return errors, count


def validate_user_prompt(root: Path) -> tuple[list[str], int]:
    relative = "docs/user-prompt.md"
    path = root / relative
    if not path.is_file():
        return [], 0
    try:
        text = path.read_text(encoding="utf-8")
    except UnicodeError as error:
        return [f"{relative}: user prompt is not valid UTF-8: {error}"], 0
    character_count = len(text.rstrip("\r\n"))
    if character_count > 1500:
        return [
            f"{relative}: user prompt exceeds 1500 characters: {character_count}"
        ], character_count
    return [], character_count


def validate_control_policy(root: Path) -> list[str]:
    errors: list[str] = []
    documents: dict[str, str] = {}
    for relative, required_phrases in CONTROL_POLICY_REQUIREMENTS.items():
        path = root / relative
        if not path.is_file():
            continue
        text = path.read_text(encoding="utf-8")
        documents[relative] = text
        for phrase in required_phrases:
            if phrase not in text:
                errors.append(
                    f"{relative}: restored control-byte wording is missing: {phrase}"
                )
    for relative in CONTROL_POLICY_FILES:
        text = documents.get(relative)
        if text is None:
            continue
        for contradiction in KNOWN_CONTROL_CONTRADICTIONS:
            if contradiction in text:
                errors.append(
                    f"{relative}: known control-byte contradiction is present: "
                    f"{contradiction}"
                )
    return errors


def validate_readiness(root: Path) -> list[str]:
    errors: list[str] = []
    for relative, markers in READINESS_MARKERS.items():
        path = root / relative
        if not path.is_file():
            continue
        text = path.read_text(encoding="utf-8")
        for marker in markers:
            if marker not in text:
                errors.append(
                    f"{relative}: readiness marker is missing: {marker}"
                )
    return errors


def validate_legacy_severity(root: Path) -> list[str]:
    errors: list[str] = []
    for relative in ACTIVE_MARKDOWN:
        path = root / relative
        if not path.is_file():
            continue
        text = path.read_text(encoding="utf-8")
        for line_number, line in prose_lines(text):
            matches = LEGACY_SEVERITY.findall(line)
            if not matches or (relative, line) in LEGACY_SEVERITY_ALLOWED_LINES:
                continue
            for severity in sorted(set(matches)):
                errors.append(
                    f"{relative}:{line_number}: legacy severity is asserted outside "
                    f"an allowed historical context: {severity}"
                )
    return errors


def validate_secret_policy_candidates(root: Path) -> list[str]:
    errors: list[str] = []
    for relative in ACTIVE_MARKDOWN:
        path = root / relative
        if not path.is_file():
            continue
        text = path.read_text(encoding="utf-8")
        for line_number, line in enumerate(text.splitlines(), start=1):
            matches = RETIRED_SECRET_CANDIDATE.findall(line)
            allowed_historical_line = (relative, line) in RETIRED_SECRET_ALLOWED_LINES
            if matches and not allowed_historical_line:
                for candidate in sorted(set(matches)):
                    errors.append(
                        f"{relative}:{line_number}: retired secret redaction candidate "
                        f"is asserted: {candidate}"
                    )
            if "secret_rendering" in line and not allowed_historical_line:
                values = [
                    first or second
                    for first, second in SECRET_RENDERING_VALUE.findall(line)
                ]
                if not values or any(value != "literal_all" for value in values):
                    errors.append(
                        f"{relative}:{line_number}: secret_rendering branch is not "
                        "fixed to literal_all"
                    )
    return errors


def validate_project_install_policy(root: Path) -> list[str]:
    errors: list[str] = []
    for relative in ACTIVE_MARKDOWN:
        path = root / relative
        if not path.is_file():
            continue
        text = path.read_text(encoding="utf-8")
        for line_number, line in prose_lines(text):
            if (
                PROJECT_INSTALL_ASSERTION.search(line)
                and not any(marker in line for marker in PROJECT_INSTALL_NEGATIONS)
            ):
                errors.append(
                    f"{relative}:{line_number}: project-local product installation "
                    "is asserted"
                )
    return errors


def exact_key_errors(schema: str, label: str, value: object, expected: set[str]) -> list[str]:
    if not isinstance(value, dict):
        return [f"{schema} {label} must be a JSON object"]
    missing = sorted(expected.difference(value))
    unexpected = sorted(set(value).difference(expected))
    errors = []
    if missing:
        errors.append(f"{schema} {label} is missing keys: {', '.join(missing)}")
    if unexpected:
        errors.append(f"{schema} {label} has unexpected keys: {', '.join(unexpected)}")
    return errors


def validate_m0_schema_examples(root: Path) -> list[str]:
    relative = "docs/plan/report-template.md"
    path = root / relative
    if not path.is_file():
        return []
    text = path.read_text(encoding="utf-8")
    fences, _ = json_fences(path, text)
    examples: dict[str, list[tuple[int, dict[str, object]]]] = {
        schema: [] for schema in M0_SCHEMA_KEYS
    }
    errors: list[str] = []
    for line, payload in fences:
        try:
            value = json.loads(
                payload,
                object_pairs_hook=reject_duplicate_keys,
                parse_constant=reject_nonstandard_constant,
            )
        except (json.JSONDecodeError, ValueError):
            continue
        if not isinstance(value, dict):
            continue
        schema = value.get("schema_version")
        if isinstance(schema, str) and schema.startswith("m0-"):
            if schema not in examples:
                errors.append(f"{relative}:{line}: unexpected M0 schema example: {schema}")
            else:
                examples[schema].append((line, value))

    for schema, expected_keys in M0_SCHEMA_KEYS.items():
        matches = examples[schema]
        if len(matches) != 1:
            errors.append(
                f"{relative}: {schema} expected exactly one top-level example, "
                f"found {len(matches)}"
            )
            continue
        line, value = matches[0]
        prefix = f"{relative}:{line}: "
        errors.extend(
            prefix + error
            for error in exact_key_errors(schema, "example", value, expected_keys)
        )
        for (nested_schema, field), nested_keys in M0_NESTED_KEYS.items():
            if nested_schema != schema or field not in value:
                continue
            errors.extend(
                prefix + error
                for error in exact_key_errors(
                    schema, f"example.{field}", value[field], nested_keys
                )
            )
        for (item_schema, field), item_keys in M0_ARRAY_ITEM_KEYS.items():
            if item_schema != schema or field not in value:
                continue
            items = value[field]
            if not isinstance(items, list):
                errors.append(f"{prefix}{schema} example.{field} must be a JSON array")
                continue
            for index, item in enumerate(items):
                errors.extend(
                    prefix + error
                    for error in exact_key_errors(
                        schema, f"example.{field}[{index}]", item, item_keys
                    )
                )
        for (deep_schema, parent, field), nested_keys in M0_DEEP_NESTED_KEYS.items():
            if deep_schema != schema or parent not in value:
                continue
            parent_value = value[parent]
            if not isinstance(parent_value, dict) or field not in parent_value:
                errors.append(f"{prefix}{schema} example.{parent}.{field} is missing")
                continue
            errors.extend(
                prefix + error
                for error in exact_key_errors(
                    schema,
                    f"example.{parent}.{field}",
                    parent_value[field],
                    nested_keys,
                )
            )

        if schema == "m0-test-profile/v1":
            helpers = value.get("helpers")
            if isinstance(helpers, list) and len(helpers) == 2:
                roles = [helper.get("role") for helper in helpers if isinstance(helper, dict)]
                sentinels = [
                    helper.get("allowed_sentinels")
                    for helper in helpers
                    if isinstance(helper, dict)
                ]
                if roles != ["default", "failure"]:
                    errors.append(
                        f"{prefix}{schema} helpers must be ordered default, failure"
                    )
                if sentinels != [["high", "low", "info"], ["low", "info"]]:
                    errors.append(
                        f"{prefix}{schema} helper sentinel allow-lists do not match"
                    )
            else:
                errors.append(f"{prefix}{schema} helpers must contain exactly two items")
        elif schema == "m0-fixture-manifest/v1":
            ordered_roles = {
                "helper_fixtures": ["default", "failure", "near_match"],
                "native_fixtures": [
                    "prompt",
                    "pre_tool_use",
                    "result_success",
                    "result_failure",
                    "stop",
                ],
            }
            for field, expected_roles in ordered_roles.items():
                items = value.get(field)
                roles = (
                    [item.get("role") for item in items if isinstance(item, dict)]
                    if isinstance(items, list)
                    else []
                )
                if roles != expected_roles:
                    errors.append(
                        f"{prefix}{schema} {field} roles do not match the required order"
                    )
    return errors


def main() -> int:
    parser = argparse.ArgumentParser(description="Validate the active documentation contract.")
    parser.add_argument("--root", type=Path, default=Path(__file__).resolve().parent.parent)
    args = parser.parse_args()
    root = args.root.resolve()

    errors = [
        f"{relative}: required active Markdown file is missing"
        for relative in ACTIVE_MARKDOWN
        if not (root / relative).is_file()
    ]
    paths = markdown_paths(root)
    json_errors, json_count = validate_fenced_json(root, paths)
    errors.extend(json_errors)
    active_paths = [root / relative for relative in ACTIVE_MARKDOWN]
    link_errors, link_count = validate_local_links(root, active_paths)
    errors.extend(link_errors)
    prompt_errors, prompt_count = validate_user_prompt(root)
    errors.extend(prompt_errors)
    errors.extend(validate_readiness(root))
    errors.extend(validate_legacy_severity(root))
    errors.extend(validate_secret_policy_candidates(root))
    errors.extend(validate_project_install_policy(root))
    errors.extend(validate_control_policy(root))
    errors.extend(validate_m0_schema_examples(root))
    if errors:
        for error in errors:
            print(error, file=sys.stderr)
        return 1

    print(
        "docs contract: ok "
        f"({len(ACTIVE_MARKDOWN)} active Markdown files, "
        f"{json_count} fenced JSON examples, {link_count} local links, "
        f"user prompt {prompt_count}/1500 characters)"
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
